{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "upgrade-cards.json#",
  "title": "Schema for the upgrade cards data file",
  "type": "object",
  "definitions": {},
  "properties": {
    "id": {
      "description": "Id for entry: a UUID (see docs/data-model.md).",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "name": {
      "type": "string",
      "description": "Upgrade card name",
      "minLength": 1
    },
    "back_id": {
      "description": "Foreign key to this card's back in data/card-backs.json.",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "image": {
      "description": "The file path for this upgrade card's image.",
      "$ref": "definitions.json#/definitions/image-file-path"
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "description": "Traits that apply to this upgrade card.",
      "uniqueItems": true,
      "items": {
        "description": "A trait that applies to this upgrade.",
        "$ref": "definitions.json#/definitions/item-trait"
      }
    },
    "type": {
      "description": "Upgrade type: an item.",
      "allOf": [
        {"$ref": "definitions.json#/definitions/buff-type"},
        {"enum": ["Armor", "Equipment", "Melee Weapon", "Melee Weapon Modification", "Ranged Weapon", "Ranged Weapon Modification"]}
      ]
    },
    "tier": {
      "type": "integer",
      "description": "Upgrade Tier",
      "minimum": 1,
      "maximum": 3
    },
    "credits": {
      "type": "integer",
      "description": "Upgrade cost",
      "minimum": 0,
      "multipleOf" : 10
    }
  },
  "required": [
    "id",
    "name",
    "back_id",
    "image",
    "traits"
  ],
  "additionalProperties": false
}