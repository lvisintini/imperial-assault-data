{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "reward-cards.json#",
  "title": "Schema for the reward cards data file",
  "type": "object",
  "definitions": {},
  "properties": {
    "id": {
      "description": "Id for entry: a UUID (see docs/data-model.md).",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "name": {
      "type": "string",
      "description": "Reward card name",
      "minLength": 1
    },
    "image": {
      "description": "The file path for this reward card's image.",
      "$ref": "definitions.json#/definitions/image-file-path"
    },
    "traits": {
      "description": "Traits that apply to this reward card.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "description": "A trait that applies to this reward.",
            "$ref": "definitions.json#/definitions/item-trait"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "description": "Reward type",
      "$ref": "definitions.json#/definitions/buff-type"
    },
    "class": {
      "description": "Boon or Bane for Return to Hoth's threat mission rewards (a Boon goes to the Rebel players, a Bane to the Imperial player); Regular for every other reward.",
      "enum": [
        "Regular",
        "Boon",
        "Bane"
      ]
    },
    "for": {
      "description": "Who receives this reward card.",
      "enum": [
        "Imperial player",
        "Rebel players"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "image",
    "traits",
    "type",
    "class",
    "for"
  ],
  "additionalProperties": false
}