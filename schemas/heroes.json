{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "heroes.json#",
  "title": "Schema for the heroes data file",
  "type": "object",
  "definitions": {},
  "properties": {
    "id": {
      "description": "Id for entry: a UUID (see docs/data-model.md).",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "name": {
      "type": "string",
      "description": "Hero name",
      "minLength": 1
    },
    "healthy": {
      "description": "The file path for this hero's healthy image.",
      "$ref": "definitions.json#/definitions/image-file-path"
    },
    "wounded": {
      "description": "The file path for this hero's wounded image.",
      "$ref": "definitions.json#/definitions/image-file-path"
    }
  },
  "required": [
    "id",
    "name",
    "healthy",
    "wounded"
  ],
  "additionalProperties": false
}