{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "campaign-threat-missions.json#",
  "title": "Schema for the campaign threat missions data file",
  "type": "object",
  "definitions": {},
  "properties": {
    "id": {
      "description": "Id for entry: a UUID (see docs/data-model.md).",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "name": {
      "type": "string",
      "description": "Threat mission name",
      "minLength": 1
    },
    "back_id": {
      "description": "Foreign key to this card's back in data/card-backs.json.",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "image": {
      "description": "The file path for this threat mission's image.",
      "$ref": "definitions.json#/definitions/image-file-path"
    }
  },
  "required": [
    "id",
    "name",
    "back_id",
    "image"
  ],
  "additionalProperties": false
}