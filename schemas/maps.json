{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "maps.json#",
  "title": "Schema for the maps data file: every mission's map (skirmish, four-player, raid)",
  "type": "object",
  "definitions": {},
  "properties": {
    "id": {
      "description": "Id for entry: a UUID (see docs/data-model.md).",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "name": {
      "type": "string",
      "description": "Skirmish map name",
      "minLength": 1
    },
    "image": {
      "description": "The file path for this skirmish maps's image.",
      "$ref": "definitions.json#/definitions/image-file-path"
    }
  },
  "required": [
    "id",
    "name",
    "image"
  ],
  "additionalProperties": false
}