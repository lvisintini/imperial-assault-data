{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "source.json#",
  "title": "Schema for the sources data file",
  "type": "object",
  "definitions": {},
  "properties": {
    "id": {
      "description": "Id for entry: a UUID (see docs/data-model.md).",
      "$ref": "definitions.json#/definitions/uuid"
    },
    "name": {
      "type": "string",
      "description": "Source name",
      "minLength": 1
    },
    "image": {
      "description": "The file path for this source's image.",
      "$ref": "definitions.json#/definitions/image-file-path"
    },
    "type": {
      "type": "string",
      "description": "Source type.",
      "enum": [
        "Core Game",
        "Expansion",
        "Ally Pack",
        "Villain Pack"
      ]
    },
    "wave": {
      "description": "Wave number",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "product_code": {
      "description": "FFG's product code (SKU), e.g. SWI01. Null for products without one of their own.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^SWI\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "announced_date": {
      "description": "The date FFG announced the product.",
      "oneOf": [
        {
          "$ref": "definitions.json#/definitions/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_date": {
      "description": "The date the product was released.",
      "oneOf": [
        {
          "$ref": "definitions.json#/definitions/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "included_in": {
      "description": "The source this product ships inside (e.g. the Luke Skywalker Ally Pack in the Core Set), or null when it's sold on its own.",
      "oneOf": [
        {
          "$ref": "definitions.json#/definitions/uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "image",
    "wave",
    "product_code",
    "announced_date",
    "release_date",
    "included_in"
  ],
  "additionalProperties": false
}