{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "definitions.json#",
  "title": "Schema for common fields in data files",
  "definitions": {
    "uuid": {
      "type": "string",
      "description": "A record id: a lowercase UUID. Records from 1.x have uuid5 ids derived from their old numeric ids (docs/data-model.md).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "content_type": {
      "type": "string",
      "description": "Content type in imperial-assault-data dataset.",
      "enum": [
        "sources",
        "maps",
        "agenda-cards",
        "agenda-decks",
        "command-cards",
        "condition-cards",
        "deployment-cards",
        "heroes",
        "hero-class-cards",
        "imperial-classes",
        "imperial-class-cards",
        "supply-cards",
        "campaign-story-mission-cards",
        "campaign-hero-side-mission-cards",
        "campaign-ally-side-mission-cards",
        "campaign-regular-side-mission-cards",
        "reward-cards",
        "companion-cards",
        "upgrade-cards",
        "card-backs",
        "campaign-threat-mission-cards",
        "form-cards",
        "skirmish-mission-cards",
        "raid-missions",
        "epilogue-cards",
        "miniatures",
        "documents",
        "missions",
        "mission-rewards",
        "record-links"
      ]
    },
    "affiliation": {
      "type": "string",
      "description": "Affiliation for component in the game.",
      "enum": [
        "Rebel",
        "Imperial",
        "Mercenary",
        "Neutral"
      ]
    },
    "item-trait": {
      "type": "string",
      "description": "Trait for items in the game.",
      "enum": [
        "Accessory",
        "Ammunition",
        "Armor",
        "Balance",
        "Barrel",
        "Blade",
        "Blaster",
        "Club",
        "Consumable",
        "Disruptor",
        "Energy",
        "Enhancement",
        "Explosive",
        "Fist",
        "Heavy",
        "Helmet",
        "Impact",
        "Light",
        "Lightsaber",
        "Medical",
        "Medium",
        "Modification",
        "Pistol",
        "Projectile",
        "Rifle",
        "Sights",
        "Staff"
      ]
    },
    "supply-trait": {
      "type": "string",
      "description": "Trait for supply items in the game.",
      "enum": [
        "Consumable",
        "Droid",
        "Energy",
        "Explosive",
        "Intel",
        "Medical",
        "Tool",
        "Valuable"
      ]
    },
    "deployment-trait": {
      "type": "string",
      "description": "Trait for deployment cards in the game.",
      "enum": [
        "Spy",
        "Brawler",
        "Force User",
        "Skirmish Upgrade",
        "Wookiee",
        "Guardian",
        "Trooper",
        "Creature",
        "Heavy Weapon",
        "Leader",
        "Smuggler",
        "Vehicle",
        "Hunter",
        "Droid"
      ]
    },
    "buff-type": {
      "type": "string",
      "description": "Upgrade/Reward/Feat type.",
      "enum": [
        "Armor",
        "Equipment",
        "Feat",
        "Melee Weapon",
        "Melee Weapon Modification",
        "Ranged Weapon",
        "Ranged Weapon Modification"
      ]
    },
    "image-file-path": {
      "type": "string",
      "description": "A file path for an image in this package.",
      "pattern": "^[a-zA-Z\\(\\)\\.0-9_-](?:[a-zA-Z\\(\\)\\.0-9\\ _-]*[a-zA-Z\\(\\)\\.0-9\\ _-])?(?:\\/[a-zA-Z\\(\\)\\.0-9_-](?:[a-zA-Z\\(\\)\\.0-9\\ _-]*[a-zA-Z\\(\\)\\.0-9\\ _-])?)*\\.[a-z0-9]{3}$"
    },
    "date": {
      "type": "string",
      "description": "A calendar date, YYYY-MM-DD (Draft-04 has no date format).",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
    }
  }
}